# Committed template = production / remote (set on server or cloud-deploy).
# Local dev: copy to .env.local and use the LOCAL block — or rely on application.properties defaults.
# Do not commit .env.local.

# --- PRODUCTION (server env) ---
# DB_URL=jdbc:mysql://127.0.0.1:3306/GuildMaster?useSSL=false&serverTimezone=UTC
# DB_USERNAME=
# DB_PASSWORD=
# JWT_SECRET=
# CORS_ALLOWED_ORIGINS=https://guildmaster.duckdns.org,https://guildmasterapi.duckdns.org,https://guildmasteradmin.duckdns.org

# --- LOCAL ( .env.local or IDE run config ) ---
DB_URL=jdbc:mysql://localhost:3306/GuildMaster?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=miPassword
JWT_SECRET=
JWT_MAX_HOURS=16
JWT_IDLE_MINUTES=30
CORS_ALLOWED_ORIGINS=http://localhost:8082,http://localhost:19006,http://127.0.0.1:8082
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=60
LOGIN_BLOCK_SECONDS=300
